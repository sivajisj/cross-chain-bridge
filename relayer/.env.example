# ── Chain RPC endpoints ──────────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_KEY

# ── Relayer wallet — must be the owner of BridgeDest ─────────────
RELAYER_PRIVATE_KEY=0x_YOUR_RELAYER_PRIVATE_KEY

# ── Deployed contract addresses ───────────────────────────────────
BRIDGE_SOURCE_ADDRESS=0x_YOUR_BRIDGE_SOURCE_ADDRESS
BRIDGE_DEST_ADDRESS=0x_YOUR_BRIDGE_DEST_ADDRESS

# ── Persistence (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge_relayer

# ── Chain IDs (defaults shown are Sepolia / Polygon Amoy) ─────────
SOURCE_CHAIN_ID=11155111
DESTINATION_CHAIN_ID=80002

# ── Finality and retry behavior ───────────────────────────────────
CONFIRMATIONS_REQUIRED=5
MAX_RETRIES=5
RETRY_BASE_DELAY_MS=30000
POLL_INTERVAL_MS=15000

START_BLOCK_LOOKBACK=2000
EVENT_SCAN_BATCH_SIZE=2000