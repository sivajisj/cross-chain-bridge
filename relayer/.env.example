# ── Chain RPC endpoints ──────────────────────────────────────────
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
AMOY_RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_KEY

# ── Validator keys — threshold-of-N EIP-712 co-signers ────────────
# At minimum VALIDATOR_KEY_1 through VALIDATOR_KEY_THRESHOLD must be set.
# VALIDATOR_KEY_1's wallet submits the on-chain mint()/unlockTokens() txs.
VALIDATOR_KEY_1=0x_YOUR_VALIDATOR_1_PRIVATE_KEY
VALIDATOR_KEY_2=0x_YOUR_VALIDATOR_2_PRIVATE_KEY
VALIDATOR_KEY_3=0x_YOUR_VALIDATOR_3_PRIVATE_KEY
VALIDATOR_KEY_4=0x_YOUR_VALIDATOR_4_PRIVATE_KEY
VALIDATOR_KEY_5=0x_YOUR_VALIDATOR_5_PRIVATE_KEY
THRESHOLD=3

# ── Deployed contract addresses ───────────────────────────────────
BRIDGE_SOURCE_ADDRESS=0x_YOUR_BRIDGE_SOURCE_ADDRESS
BRIDGE_DEST_ADDRESS=0x_YOUR_BRIDGE_DEST_ADDRESS

# ── Persistence (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge_relayer

# ── Chain IDs (defaults shown are Sepolia / Polygon Amoy) ─────────
SOURCE_CHAIN_ID=11155111
DESTINATION_CHAIN_ID=80002

# ── Finality and retry behavior ───────────────────────────────────
CONFIRMATIONS_REQUIRED=5
MAX_RETRIES=5
RETRY_BASE_DELAY_MS=30000
POLL_INTERVAL_MS=15000

START_BLOCK_LOOKBACK=2000
EVENT_SCAN_BATCH_SIZE=2000

# ── Bridge explorer / metrics REST API ────────────────────────────
API_PORT=3001

# ── Solana leg (Phase 6) — optional ────────────────────────────────
# Leave both unset to run the relayer exactly as it did before Phase 6;
# setting them starts the Solana burn-scan loop alongside the two EVM
# scans. VALIDATOR_KEY_1..5 above are reused to derive ed25519 keypairs.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_PROGRAM_ID=YOUR_DEPLOYED_BRIDGE_PROGRAM_ID
# SOLANA_COMMITMENT=finalized
# SOLANA_SCAN_BATCH_SIZE=200